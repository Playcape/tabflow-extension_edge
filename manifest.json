{
  "manifest_version": 3,
  "name": "TabFlow — Tab Manager",
  "version": "1.1.1",
  "description": "A beautiful new tab manager with spaces, collections, drag & drop, and hotkeys.",
  "permissions": ["tabs", "storage", "windows", "webNavigation"],
  "omnibox": { "keyword": "to" },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabFlow"
  },
  "commands": {
    "tabflow-slot-1": { "suggested_key": { "default": "Alt+1" }, "description": "TabFlow: Hotkey slot 1" },
    "tabflow-slot-2": { "suggested_key": { "default": "Alt+2" }, "description": "TabFlow: Hotkey slot 2" },
    "tabflow-slot-3": { "suggested_key": { "default": "Alt+3" }, "description": "TabFlow: Hotkey slot 3" },
    "tabflow-slot-4": { "suggested_key": { "default": "Alt+4" }, "description": "TabFlow: Hotkey slot 4" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
