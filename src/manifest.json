{
  "manifest_version": 3,
  "name": "TabFlow — Tab Manager",
  "version": "2.0.0",
  "description": "Your local browser workspace. Organize tabs, save sessions, keep Pages and focus with three distinctive designs.",
  "permissions": ["tabs", "storage", "sessions", "bookmarks", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open TabFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "omnibox": { "keyword": "to" },
  "commands": {
    "tabflow-slot-1": { "suggested_key": { "default": "Alt+1" }, "description": "TabFlow: open hotkey slot 1" },
    "tabflow-slot-2": { "suggested_key": { "default": "Alt+2" }, "description": "TabFlow: open hotkey slot 2" },
    "tabflow-slot-3": { "suggested_key": { "default": "Alt+3" }, "description": "TabFlow: open hotkey slot 3" },
    "tabflow-slot-4": { "suggested_key": { "default": "Alt+4" }, "description": "TabFlow: open hotkey slot 4" }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; child-src 'self'"
  },
  "sandbox": {
    "pages": ["newtab/sandbox.html"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabflow@playcape.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
